# Copiá este archivo a ".env" y completá los valores reales.
# NUNCA subas el archivo ".env" real a un repositorio público.

# Conexión a PostgreSQL. Reemplazá por los datos reales de tu base
# (los provee el hosting que elijas: Railway, Render, Supabase, Neon, un VPS propio, etc.)
DATABASE_URL=postgresql://gripmedias_owner:npg_hG2z3RrHmOxa@ep-rough-snow-b6r5zr3b-pooler.c-2.sa-east-1.aws.neon.tech/gripmedias?sslmode=require&channel_binding=require

# Si tu proveedor de Postgres requiere SSL (la mayoría de los hostings en la nube lo requieren)
PGSSL=true

# Puerto en el que corre el servidor Express
PORT=3001

# Orígenes permitidos para CORS (el/los dominios donde vive el frontend), separados por coma.
# Ejemplo: https://gripmedias.com.ar,https://www.gripmedias.com.ar
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8081,http://127.0.0.1:8081

# ---- Mercado Pago (Checkout Pro) ----
# Access Token de la cuenta de GRIP MEDIAS en Mercado Pago. Usá el de PRUEBA
# mientras desarrollamos (empieza con "TEST-"); en producción se reemplaza
# por el de producción (empieza con "APP_USR-"). Se obtiene en:
# https://www.mercadopago.com.ar/developers/panel → tu aplicación → Credenciales
MERCADOPAGO_ACCESS_TOKEN=

# Opcional pero recomendado: secreto de firma del webhook, se genera en el
# panel de Mercado Pago Developers al configurar la URL de notificaciones
# ("Webhooks" → clave secreta). Mientras esté vacío, el backend NO valida la
# firma de las notificaciones entrantes (solo para poder probar en local).
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública por la que Mercado Pago puede llegar a ESTE backend para
# mandar el webhook de notificaciones (POST /webhooks/mercadopago).
# En desarrollo local, "http://localhost:3001" NO sirve: Mercado Pago no
# puede alcanzar tu máquina. Hace falta un túnel HTTPS (ver README).
# En producción, poné acá la URL pública real del backend ya desplegado.
BACKEND_PUBLIC_URL=

# URL pública del FRONTEND (la tienda), usada para armar los back_urls
# (success/failure/pending) a los que Mercado Pago redirige al comprador
# después de pagar. En desarrollo local podés usar la URL de http-server,
# por ejemplo http://127.0.0.1:8081 (auto_return queda deshabilitado hasta
# que sea HTTPS, ver README). En producción, el dominio real de la tienda.
FRONTEND_PUBLIC_URL=

# ---- Correo Argentino (MiCorreo) ----
# Base URL de la API de MiCorreo.
CORREO_ARGENTINO_BASE_URL=https://api.correoargentino.com.ar/micorreo/v1

# Usuario y contraseña de tu cuenta de MiCorreo (Basic Auth contra /token).
# NUNCA subas estos valores reales a un repositorio.
CORREO_ARGENTINO_USERNAME=BGayserAPI
CORREO_ARGENTINO_PASSWORD=Perfume26+

# customerId de tu cuenta de MiCorreo.
CORREO_ARGENTINO_CUSTOMER_ID=0001543748

# Código postal de origen de los envíos (Rosario, Santa Fe = 2000).
CORREO_ARGENTINO_ORIGIN_POSTAL_CODE=2000
